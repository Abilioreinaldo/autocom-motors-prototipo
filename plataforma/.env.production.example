APP_NAME="Autocom Motors"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://autocommotors.com.br
APP_PORT=8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=autocom
DB_USERNAME=autocom
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@autocommotors.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# --- Autocom Motors ---
AUTOCOM_WHATSAPP=5515999990000
AUTOCOM_TELEFONE="(15) 3000-0000"
AUTOCOM_EMAIL=contato@autocommotors.com.br
AUTOCOM_ENDERECO="Av. Exemplo, 1000 — Centro, Tatuí/SP"
AUTOCOM_TAXA_MENSAL=1.69
AUTOCOM_LOCARX_URL=https://locarx.com.br
AUTOCOM_LOCARX_WHATSAPP=5515999990001

# --- Webmotors (API Site) — ative somente com credenciais do lojista ---
WEBMOTORS_ENABLED=false
WEBMOTORS_DRIVER=fake
WEBMOTORS_API_URL=https://api.webmotors.com.br/apisite/v1
WEBMOTORS_CLIENT_ID=
WEBMOTORS_CLIENT_SECRET=
WEBMOTORS_DEALER_ID=

# Entrypoint: roda migrate automaticamente ao subir o container app
AUTOCOM_AUTO_MIGRATE=true
